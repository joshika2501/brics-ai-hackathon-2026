/* =========================================================
   HYPERLOCAL MAP — CSS HOTSPOT MARKERS
   Avoids emoji/Unicode rendering problems
   ========================================================= */

.map-pin {
  position: absolute !important;

  width: 18px !important;
  height: 18px !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  border-radius: 50% !important;

  transform: translate(-50%, -50%) !important;

  z-index: 10 !important;
}

.map-pin i {
  display: block !important;

  width: 12px !important;
  height: 12px !important;

  border-radius: 50% !important;

  background: currentColor !important;

  box-shadow:
    0 0 0 4px rgba(255,255,255,0.08),
    0 0 18px currentColor !important;
}

/* HIGH */
.map-pin.p1,
.map-pin.p2 {
  color: #ff5c5c !important;
}

/* MODERATE */
.map-pin.p3 {
  color: #ff9f43 !important;
}

/* LOWER RISK */
.map-pin.p4 {
  color: #f6c344 !important;
}

/* Optional pulse animation */

.map-pin::after {
  content: "" !important;

  position: absolute !important;

  width: 22px !important;
  height: 22px !important;

  border: 1px solid currentColor !important;

  border-radius: 50% !important;

  opacity: 0.35 !important;

  animation: hotspotPulse 2s ease-out infinite !important;
}

@keyframes hotspotPulse {
  0% {
    transform: scale(0.6);
    opacity: 0.55;
  }

  70% {
    transform: scale(1.35);
    opacity: 0;
  }

  100% {
    transform: scale(1.35);
    opacity: 0;
  }
}

/* Map label */

.map-label {
  letter-spacing: 2px !important;
  font-size: 12px !important;
  font-weight: 500 !important;
}

/* =========================================================
   MAP POSITIONING
   ========================================================= */

.map-pin.p1 {
  left: 35% !important;
  top: 38% !important;
}

.map-pin.p2 {
  left: 70% !important;
  top: 40% !important;
}

.map-pin.p3 {
  left: 58% !important;
  top: 57% !important;
}

.map-pin.p4 {
  left: 47% !important;
  top: 76% !important;
}

/* =========================================================
   FINAL HOTSPOT MARKER FIX
   CSS ONLY — NO TEXT / EMOJI
   ========================================================= */

.map-pin {
  position: absolute !important;

  width: 24px !important;
  height: 24px !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  font-size: 0 !important;
  line-height: 0 !important;

  color: transparent !important;

  transform: translate(-50%, -50%) !important;

  z-index: 20 !important;
}

.map-pin::before {
  content: "" !important;

  display: block !important;

  width: 12px !important;
  height: 12px !important;

  border-radius: 50% !important;

  background: currentColor !important;
}

.map-pin::after {
  content: "" !important;

  position: absolute !important;

  width: 24px !important;
  height: 24px !important;

  border: 1px solid currentColor !important;

  border-radius: 50% !important;

  animation: hotspotPulse 2s ease-out infinite !important;
}

.map-pin i {
  display: none !important;
}

/* Risk colors */

.map-pin.p1,
.map-pin.p2 {
  color: #ff5555 !important;
}

.map-pin.p3 {
  color: #ff9f43 !important;
}

.map-pin.p4 {
  color: #f6c344 !important;
}

@keyframes hotspotPulse {
  0% {
    transform: scale(0.65);
    opacity: 0.7;
  }

  70% {
    transform: scale(1.35);
    opacity: 0;
  }

  100% {
    transform: scale(1.35);
    opacity: 0;
  }
}
/* =========================================================
   BRICS ECOSPHERE — LOGIN PAGE
   ========================================================= */

.login-page {
  min-height: 100vh;

  display: flex;
  align-items: center;
  justify-content: center;

  position: relative;

  padding: 40px 20px;

  box-sizing: border-box;

  background:
    radial-gradient(
      circle at 50% 20%,
      rgba(32, 214, 218, 0.08),
      transparent 38%
    ),
    #06131b;

  overflow: auto;
}

/* Background glow */

.login-glow {
  position: fixed;

  width: 420px;
  height: 420px;

  border-radius: 50%;

  filter: blur(100px);

  pointer-events: none;

  opacity: 0.12;
}

.login-glow-one {
  background: #18d5d9;

  top: -180px;
  left: -120px;
}

.login-glow-two {
  background: #1685a0;

  right: -150px;
  bottom: -180px;
}

/* =========================================================
   CARD
   ========================================================= */

.login-card {
  position: relative;

  width: min(640px, 100%);

  padding: 52px;

  box-sizing: border-box;

  border: 1px solid rgba(105, 158, 180, 0.28);

  border-radius: 28px;

  background:
    linear-gradient(
      145deg,
      rgba(18, 37, 48, 0.96),
      rgba(10, 27, 37, 0.96)
    );

  box-shadow:
    0 30px 80px rgba(0, 0, 0, 0.38),
    inset 0 1px 0 rgba(255,255,255,0.025);

  z-index: 2;
}

/* =========================================================
   BRAND
   ========================================================= */

.login-brand {
  display: flex;

  align-items: center;

  gap: 22px;

  margin-bottom: 42px;
}

.login-logo {
  width: 96px;
  height: 96px;

  flex: 0 0 96px;

  display: flex;

  align-items: center;
  justify-content: center;

  padding: 7px;

  box-sizing: border-box;

  border: 1px solid rgba(31, 219, 222, 0.75);

  border-radius: 22px;

  background: rgba(5, 25, 34, 0.8);

  box-shadow:
    0 0 25px rgba(28, 213, 216, 0.12);
}

.login-logo img {
  width: 100%;
  height: 100%;

  object-fit: contain;

  display: block;
}

.login-brand-text h1 {
  margin: 0;

  font-size: 31px;

  line-height: 1.1;

  font-weight: 750;

  letter-spacing: -0.7px;

  color: #eef5f8;
}

.login-brand-text h1 span {
  color: #38d8dc;
}

.login-brand-text p {
  margin: 8px 0 0;

  font-size: 16px;

  color: #8ea5b3;
}

/* =========================================================
   KICKER
   ========================================================= */

.login-kicker {
  margin-bottom: 26px;

  font-size: 13px;

  font-weight: 700;

  letter-spacing: 3px;

  color: #819aaa;
}

/* =========================================================
   TITLE
   ========================================================= */

.login-title {
  margin: 0;

  font-size: clamp(38px, 5vw, 52px);

  line-height: 1.08;

  letter-spacing: -1.8px;

  font-weight: 800;

  color: #f4f7f9;
}

.login-title::first-letter {
  color: #f4f7f9;
}

.login-description {
  margin: 22px 0 38px;

  font-size: 17px;

  line-height: 1.5;

  color: #8da8b8;
}

/* =========================================================
   FORM
   ========================================================= */

.login-form {
  display: flex;

  flex-direction: column;

  gap: 22px;
}

.login-form label {
  display: flex;

  flex-direction: column;

  gap: 9px;
}

.login-form label span {
  font-size: 14px;

  color: #94aabd;
}

.login-form input {
  width: 100%;

  height: 70px;

  padding: 0 20px;

  box-sizing: border-box;

  border: 1px solid rgba(88, 137, 158, 0.28);

  border-radius: 15px;

  outline: none;

  background: rgba(22, 42, 54, 0.78);

  color: #eef6f8;

  font-size: 18px;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.login-form input::placeholder {
  color: #6f8796;
}

.login-form input:focus {
  border-color: #25d3d7;

  box-shadow:
    0 0 0 3px rgba(37, 211, 215, 0.10);
}

/* =========================================================
   SIGN IN
   ========================================================= */

.login-submit {
  width: 100%;

  height: 68px;

  margin-top: 2px;

  display: flex;

  align-items: center;
  justify-content: center;

  gap: 12px;

  border: 0;

  border-radius: 15px;

  background: #2ed0d5;

  color: #04151b;

  font-size: 20px;

  font-weight: 750;

  cursor: pointer;

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.login-submit:hover {
  transform: translateY(-1px);

  box-shadow:
    0 10px 30px rgba(46, 208, 213, 0.22);
}

/* =========================================================
   DIVIDER
   ========================================================= */

.login-divider {
  display: flex;

  align-items: center;

  gap: 16px;

  margin: 32px 0;
}

.login-divider span {
  height: 1px;

  flex: 1;

  background: rgba(104, 145, 160, 0.28);
}

.login-divider b {
  font-size: 13px;

  font-weight: 500;

  color: #8298a7;
}

/* =========================================================
   DEMO BUTTON
   ========================================================= */

.demo-button {
  width: 100%;

  height: 66px;

  display: flex;

  align-items: center;
  justify-content: center;

  gap: 12px;

  border: 1px solid rgba(93, 142, 163, 0.30);

  border-radius: 15px;

  background: transparent;

  color: #edf5f7;

  font-size: 18px;

  cursor: pointer;

  transition:
    border-color 0.2s ease,
    background 0.2s ease;
}

.demo-button svg {
  color: #27d6da;
}

.demo-button:hover {
  border-color: rgba(39, 214, 218, 0.55);

  background: rgba(39, 214, 218, 0.05);
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 650px) {

  .login-page {
    padding: 20px 14px;
  }

  .login-card {
    padding: 32px 24px;

    border-radius: 22px;
  }

  .login-brand {
    gap: 16px;

    margin-bottom: 32px;
  }

  .login-logo {
    width: 72px;
    height: 72px;

    flex-basis: 72px;

    border-radius: 17px;
  }

  .login-brand-text h1 {
    font-size: 24px;
  }

  .login-brand-text p {
    font-size: 14px;
  }

  .login-kicker {
    font-size: 11px;

    letter-spacing: 2px;
  }

  .login-title {
    font-size: 36px;
  }

  .login-description {
    font-size: 15px;
  }
}
