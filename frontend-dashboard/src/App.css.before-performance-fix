/* =========================================================
   BRICS HEADER FIX
   Keeps title + subtitle properly aligned on desktop
   ========================================================= */

.topbar {
  display: flex;
  align-items: center;
  gap: 28px;
  min-height: 124px;
  padding: 18px 32px;
}

.topbar .brand {
  display: flex;
  align-items: center;
  gap: 18px;
  flex: 1 1 auto;
  min-width: 0;
  overflow: visible;
}

.topbar .brand > div:last-child {
  min-width: 0;
  flex: 1 1 auto;
  overflow: visible;
}

.topbar .brand h1 {
  margin: 0;
  white-space: nowrap;
  word-break: normal;
  overflow: visible;
  font-size: clamp(28px, 2vw, 36px);
  line-height: 1.1;
  letter-spacing: -0.8px;
}

.topbar .brand h1 span {
  white-space: nowrap;
}

.topbar .brand p {
  margin: 8px 0 0;
  white-space: nowrap;
  word-break: normal;
  overflow: visible;
  font-size: 17px;
  line-height: 1.35;
}

.topbar .brand-icon {
  flex: 0 0 56px;
}

.topbar .header-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 0 0 auto;
  white-space: nowrap;
}

/* Keep controls from forcing the brand to wrap */
.topbar .connection,
.topbar .city-select,
.topbar .icon-button,
.topbar .language-select,
.topbar .refresh-button {
  flex-shrink: 0;
}

/* =========================================================
   Desktop
   ========================================================= */

@media (min-width: 1200px) {
  .topbar .brand h1 {
    font-size: 34px;
  }

  .topbar .brand p {
    font-size: 17px;
  }
}

/* =========================================================
   Medium screens
   ========================================================= */

@media (max-width: 1199px) {
  .topbar {
    gap: 18px;
    padding: 16px 24px;
  }

  .topbar .brand h1 {
    font-size: 28px;
  }

  .topbar .brand p {
    font-size: 15px;
  }

  .topbar .header-actions {
    gap: 8px;
  }
}

/* =========================================================
   Mobile / narrow screens
   ========================================================= */

@media (max-width: 900px) {
  .topbar {
    min-height: auto;
    flex-wrap: wrap;
  }

  .topbar .brand {
    flex: 1 1 100%;
  }

  .topbar .brand h1 {
    white-space: normal;
    font-size: 28px;
  }

  .topbar .brand p {
    white-space: normal;
    font-size: 14px;
  }

  .topbar .header-actions {
    width: 100%;
    justify-content: flex-end;
  }
}
/* =========================================================
   FINAL HEADER LAYOUT FIX
   ========================================================= */

.topbar {
  display: flex !important;
  align-items: center !important;
  width: 100%;
  box-sizing: border-box;
  min-height: 120px;
  padding: 18px 28px !important;
  gap: 24px;
  overflow: hidden;
}

/* Brand occupies only the space available before controls */
.topbar .brand {
  display: flex !important;
  align-items: center !important;
  gap: 16px;
  flex: 1 1 auto !important;
  min-width: 0 !important;
  max-width: calc(100% - 760px);
  overflow: visible !important;
}

/* Icon must not shrink */
.topbar .brand-icon {
  flex: 0 0 58px !important;
  width: 58px;
  height: 58px;
}

/* Title/subtitle container */
.topbar .brand > div:last-child {
  min-width: 0 !important;
  max-width: 100%;
  overflow: hidden;
}

/* Main title */
.topbar .brand h1 {
  margin: 0 !important;
  padding: 0 !important;
  font-size: 32px !important;
  line-height: 1.15 !important;
  letter-spacing: -0.7px;
  white-space: nowrap !important;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* "Environmental Intelligence" */
.topbar .brand h1 span {
  white-space: nowrap !important;
}

/* Subtitle */
.topbar .brand p {
  margin: 7px 0 0 !important;
  padding: 0 !important;
  font-size: 15px !important;
  line-height: 1.3 !important;
  white-space: nowrap !important;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Right-side controls */
.topbar .header-actions {
  display: flex !important;
  align-items: center !important;
  justify-content: flex-end !important;
  gap: 10px !important;
  flex: 0 0 auto !important;
  width: auto;
  max-width: none;
  margin-left: auto !important;
  position: relative;
  z-index: 10;
  white-space: nowrap;
}

/* Prevent individual controls from shrinking */
.topbar .header-actions > * {
  flex-shrink: 0 !important;
}

/* Connection status */
.topbar .connection {
  min-width: 145px;
}

/* City selector */
.topbar .city-select {
  min-width: 250px;
}

/* Refresh button */
.topbar .refresh-button {
  min-width: 125px;
}

/* =========================================================
   LARGE DESKTOP
   ========================================================= */

@media (min-width: 1500px) {
  .topbar .brand {
    max-width: calc(100% - 730px);
  }

  .topbar .brand h1 {
    font-size: 34px !important;
  }

  .topbar .brand p {
    font-size: 16px !important;
  }
}

/* =========================================================
   MEDIUM DESKTOP
   ========================================================= */

